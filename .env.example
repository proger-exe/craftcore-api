# PostgreSQL
DB_HOST=localhost
DB_NAME=craftcore
DB_USER=craftcore
DB_PASS=change-me
# Telegram ID of the developer account (gets admin rights on first start)
DEV_ID=0

# Service-to-service auth: trusted backends (bots, admin panel) exchange
# client_id/client_secret for a short-lived JWT via POST /integrations/auth/token
JWT_SECRET=change-me-long-random
JWT_ALGORITHM=HS256
JWT_SERVICE_TOKEN_TTL_MINUTES=60
# "client_id:client_secret,client_id2:client_secret2"
SERVICE_CREDENTIALS=
